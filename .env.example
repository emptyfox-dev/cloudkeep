# ===== 备份源 =====
# 需要备份的路径，多个用英文逗号分隔（Docker 部署时需与 docker-compose 的 volumes 对应）
# 每个目录单独打包，上传到 BACKUP_REMOTE_DIR/<目录名>/
# 支持各平台原生写法：/data/nginx、D:\data\nginx、\\server\share\data 都可以
BACKUP_SOURCE=/data
# 宿主机上被备份的目录（挂载到容器的 /data，只读）
BACKUP_HOST_DIR=./data
# 打包时排除的路径片段，多个用英文逗号分隔，例如：cache,.git,*.log
BACKUP_EXCLUDE=

# ===== 网盘 =====
# 网盘目标根目录，必须以 / 开头（相对应用根目录，例如 /backup/docker）
# 每个备份目录使用其下的同名子目录，如 /backup/docker/nginx/、/backup/docker/mysql/
# 目录（含多级子目录）不存在时会在备份前自动逐级创建，也可手动执行:
#   docker compose run --rm cloudkeep ensure-dir
BACKUP_REMOTE_DIR=/backup/docker
# 备份文件名前缀
BACKUP_NAME_PREFIX=backup
# 每个备份目录各自保留最近几份，0 表示不清理
BACKUP_RETENTION=7
# 上传分块并发数（大文件可调大，如 5）
UPLOAD_CONCURRENCY=3
# 上传失败重试次数
UPLOAD_ATTEMPTS=2

# ===== 定时 =====
# 标准 5 段 cron 表达式：分 时 日 月 周，默认每天 03:00
# 支持 * 逗号列表 a,b 、区间 a-b 、步进 */n 与 a-b/n、月/周名称（jan..dec, mon..sun）
CRON_SCHEDULE=0 3 * * *
# 时区（由 Rust 内置时区库处理，无需容器安装 tzdata）
CRON_TIMEZONE=Asia/Shanghai
# 容器启动后是否立即执行一次备份（true/false）
RUN_ON_START=true

# ===== 授权方式（二选一，自定义百度凭证优先）=====
#
# 【方式 A · 默认】通过官方服务端获取 Token —— 无需填百度凭证
#
# 服务端地址**固定**为 https://cloudkeep.emptyfox.net，编译在二进制里，
# **不提供任何配置项**（没有对应的环境变量）。这样可避免使用者被诱导把请求
# 连同自己的租户 API Key 发往伪造的第三方服务。
#
# 客户端不必持有百度应用凭证：首次运行 `cloudkeep auth-url` 时，若本地还没有
# API Key，会自动向服务端申请一个属于你自己的租户，并把 Key 保存到
# $HOME/.cloudkeep/config.json。因此每个使用者都拥有自己的租户、
# 授权自己的百度账号，彼此隔离。API Key **无需手工填写**。
#
# 【方式 B】自定义百度开放平台应用凭证 —— 直连百度，完全不经过服务端
#
# ⚠️ 唯一可自定义的就是这一项：只要同时填了下面两项，就**直连百度**，
#    服务端会被完全绕过。适合自己已有百度开发者应用、或不想依赖服务端的场景。
# 在 https://pan.baidu.com/union/console/applist 创建应用后获取：
BAIDU_APP_KEY=
BAIDU_SECRET_KEY=
# 也可直接提供 token（可选，优先级高于本地授权文件）
# BAIDU_ACCESS_TOKEN=
# BAIDU_REFRESH_TOKEN=

# ===== 其他 =====
# 容器时区
TZ=Asia/Shanghai
# 本地临时目录（存放压缩包，上传完成后自动删除），必须是绝对路径
# 不设置时默认跟随系统临时目录：Linux/macOS 为 /tmp/cloudkeep，Windows 为 %TEMP%\cloudkeep
# Windows 上也可写 POSIX 风格路径（如 /tmp/cloudkeep），会被接受
WORK_DIR=/tmp/cloudkeep
# 只打包不上传，便于验证流程（true/false）
DRY_RUN=false
# 健康检查阈值（小时）：心跳文件超过该时长未刷新，容器标记为 unhealthy
# 建议略大于 CRON_SCHEDULE 的执行间隔（默认每天一次 → 26）
HEALTHCHECK_MAX_AGE_HOURS=26

# ===== 镜像 =====
# 部署使用的镜像地址。
# 默认是 CNB 云构建产出的公共多架构制品（linux/amd64、linux/arm64，
# docker pull 按设备架构自动选择，无需登录；ARM64 设备可直接拉取使用）。
#
# ⚠️ docker-compose.yml 里没有 build: 段 —— 默认路径统一走云制品，
#    避免"以为跑的是云端版本、实际跑的是本地未发布代码"。
#    需要本地构建时显式执行 README「镜像与云端构建」里的 docker buildx 命令，
#    再用下面的 IMAGE_REPO 指向它：
#   IMAGE_REPO=cloudkeep:latest                          # 本地构建（当前设备架构）
#   IMAGE_REPO=<registry>/<namespace>/cloudkeep:latest   # 自有仓库（推送前先 docker login）
#
# 推送到自有仓库请用 buildx 多架构（含 arm64），不要用 docker compose push（单架构会覆盖多架构 manifest）：
#   docker buildx build --platform linux/amd64,linux/arm64 -t <registry>/<namespace>/cloudkeep:latest --push .
IMAGE_REPO=docker.cnb.cool/emptyfox-network/cloudkeep:latest

# ===== 可选：高级配置 =====
# 覆盖授权文件目录（默认 $HOME/.cloudkeep，即容器内 /home/cloudkeep/.cloudkeep）
# CLOUDKEEP_CONFIG_DIR=/home/cloudkeep/.cloudkeep
# 国内构建时用 crates.io 镜像加速（仅构建期生效，见 docker-compose.yml 的 build.args）
# CARGO_MIRROR=sparse+https://rsproxy.cn/index/

# 注意：服务端地址 https://cloudkeep.emptyfox.net 是**固定**的，
# 没有 CLOUDKEEP_SERVER_URL 之类的配置项 —— 这是刻意设计，不是遗漏。
